# ---- 应用 ----
APP_ENV=dev
API_PREFIX=/api/v1

# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg2://pm:pm123@127.0.0.1:5432/pm_system

# ---- JWT ----
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL_MIN=120
JWT_REFRESH_TTL_DAY=7

# ---- 安全 ----
LOGIN_MAX_FAIL=5
LOCK_MINUTES=15

# ---- AI（OpenAI 兼容 API，内网可达）----
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# ---- 附件 / 备份 ----
UPLOAD_DIR=./data/uploads
ATTACHMENT_MAX_MB=50
BACKUP_DIR=./data/backups

# ---- CORS（前后端分离开发时填前端源，如 http://localhost:5173）----
CORS_ORIGINS=http://localhost:5173
