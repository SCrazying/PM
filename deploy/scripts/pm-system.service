[Unit]
Description=PM-System Backend (FastAPI)
After=network.target postgresql.service

[Service]
Type=simple
User={{APP_USER}}
WorkingDirectory={{APP_HOME}}/backend
EnvironmentFile=-{{APP_HOME}}/backend/.env
ExecStart={{APP_HOME}}/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port {{BACKEND_PORT}}
Restart=on-failure
RestartSec=5
# 资源与日志
StandardOutput=append:{{APP_HOME}}/logs/backend.log
StandardError=append:{{APP_HOME}}/logs/backend.err
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
